{
  "name": "sal-hacham",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "node scripts/copy-ocr.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync": "tsx scripts/sync/index.ts",
    "icons": "node scripts/make-icons.mjs",
    "deploy:israel": "tsx scripts/sync/israel-only.ts",
    "build:ios": "node scripts/copy-ocr.mjs && tsc --noEmit && vite build --outDir dist-ios --emptyOutDir && node scripts/strip-ios-build.mjs",
    "ios": "npm run build:ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "@tesseract.js-data/heb": "^1.0.0",
    "barcode-detector": "^3.2.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "description": "Shopping list that compares real supermarket prices in Israel (offline-first PWA)",
  "engines": {
    "node": ">=22"
  }
}
