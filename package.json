{
  "name": "sal-hacham",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync": "tsx scripts/sync/index.ts",
    "icons": "node scripts/make-icons.mjs",
    "deploy:local": "npm run sync -- --min-stores 400 && npm run build && gh-pages -d dist --no-history --nojekyll -m \"Update prices\""
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "barcode-detector": "^3.2.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gh-pages": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "description": "Shopping list that compares real supermarket prices in Israel (offline-first PWA)",
  "engines": {
    "node": ">=22"
  }
}
